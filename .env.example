# Perfil padrão — obrigatório.
GITHUB_USER=
# Token do perfil padrão. Use um PAT com escopo `repo` e, opcionalmente, `read:user`.
# Em desenvolvimento, `gh auth token` gera o valor. Nunca versione o .env.
GITHUB_TOKEN=
# Nome exibido no seletor de perfis. Padrão: default.
GITHUB_PROFILE_NAME=default
# URL da API. Para GitHub Enterprise use https://ghe.exemplo.com/api/v3.
GITHUB_API_URL=https://api.github.com
# Opcional: derivada de GITHUB_API_URL quando vazia.
# GITHUB_GRAPHQL_URL=
# Fuso IANA do corte mensal e da janela do heatmap. Padrão: UTC.
GITHUB_TIME_ZONE=America/Sao_Paulo
# Filtros opcionais, separados por vírgula. Valem só para os PRs; o heatmap não muda.
# Se GITHUB_REPOS estiver preenchido, ele vence GITHUB_ORGS.
# GITHUB_ORGS=minha-org,outra-org
# GITHUB_REPOS=minha-org/app,outra-org/lib
# Arquivo local (fora do git) com perfis adicionais. Padrão: ./profiles.local.json.
# Copie profiles.example.json para profiles.local.json e defina os tokens nas variáveis
# indicadas por tokenEnv; o arquivo nunca contém o valor do token.
# GITHUB_PROFILES_FILE=./profiles.local.json
